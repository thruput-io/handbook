{
  "gcp": {
    "project": "vllm-493911",
    "location": "global"
  },
  "trustedWorkspaces": [
    "/Users/Shared/workspace",
    "/~/workspace"
  ],
  "toolPermission": "always-proceed",
  "nonWorkspaceFileAccess": "allow",
  "sandbox": {
    "enabled": false
  },
  "permissions": {
    "allow": [
      "mcp(*)",
      "read_url(*)",
      "read_file(*)",
      "command(mkdir)",
      "command(ls)",
      "command(git)",
      "command(gh)",
      "command(get-gh-token.sh)",
      "command(cat)",
      "mcp(intellij-stream/execute_tool)"
    ],
    "deny": [
      "command(su)",
      "command(sudo)",
      "command(git reset --hard)"
    ],
    "filesystem": {
      "read": [
        "/Users/Shared/admin_repo/handbook/**",
        "/Users/Shared/workspace/**",
        "~/workspace/**",
        "~/.gemini/**",
        "~/secrets/**"
      ],
      "execute": [
        "/Users/Shared/admin_repo/handbook/account_per_agent/**",
        "/Users/Shared/workspace/**",
        "~/workspace/**",
        "~/.gemini/**"
      ],
      "write": [
        "/Users/Shared/workspace/**",
        "~/workspace/**",
        "~/secrets/created_by_agent/**"
      ]
    }
  }
}